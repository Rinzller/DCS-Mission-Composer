{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DCS Mission Composer",
  "version": "0.1.1",
  "identifier": "com.dcsmissioncomposer.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DCS Mission Composer",
        "width": 1120,
        "height": 720,
        "minWidth": 820,
        "minHeight": 560,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "../public/icons/favicon.ico"
    ]
  }
}
